{
  "expo": {
    "name": "syllo",
    "slug": "syllo",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/images/icon-real.png",

    "scheme": "syllo",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/icon-real.png",
      "bundleIdentifier": "com.zodiacdeveloper.syllo"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090018",
        "foregroundImage": "./assets/images/icon-12.png"
      },

      "predictiveBackGestureEnabled": false,

      "package": "com.zodiacdeveloper.syllo",

      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/icon-real.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090018",
          "image": "./assets/images/icon-12.png",
          "imageWidth": 200
        }
      ],

      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-audio",
      "expo-asset",
      "expo-sqlite"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "943e49ea-4895-4587-a437-92d2b5e38fbe"
      }
    }
  }
}